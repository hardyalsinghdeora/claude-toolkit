#!/usr/bin/env python3
"""claude-toggle — enable/disable local MCP servers and snapshot Claude Code config.

MCP servers live in ~/.claude.json (global `mcpServers` and per-project
`projects.<path>.mcpServers`). Disabling a server moves its config into
~/.claude/mcp-disabled.json so it can be restored losslessly; enabling
moves it back. Every mutation first writes a timestamped backup of
~/.claude.json into ~/.claude/backups/.

Usage:
  claude-toggle list                     # all servers, status, endpoint
  claude-toggle status                   # enabled/disabled summary, matching profile,
                                         # directive states
  claude-toggle disable <server>|@group|--all [--project <path>|--global]
  claude-toggle enable  <server>|@group|--all [--project <path>|--global]
  claude-toggle group set <name> <server> [server...]   # named server sets
  claude-toggle group list | delete <name>              # e.g. disable @work
  claude-toggle diff <profile>           # what loading this profile would change
  claude-toggle profile save <name>      # snapshot MCP config + settings.json
  claude-toggle profile load <name> [--all|--settings-only]
                                         # default loads MCP config ONLY;
                                         # --all also overwrites settings.json
  claude-toggle profile list
  claude-toggle squeeze on|off|status    # toggle the global "pipe verbose output
                                         # through squeeze" directive in ~/.claude/CLAUDE.md
  claude-toggle cindex  on|off|status    # toggle the global "search code via the
                                         # cindex index" directive in ~/.claude/CLAUDE.md
  claude-toggle dbindex on|off|status    # toggle the global "look up DB schemas via
                                         # the dbindex index" directive
  claude-toggle csession on|off|status   # toggle the global "recover past-session
                                         # context via csession" directive
  claude-toggle backups                  # list auto-backups
  claude-toggle backups prune [--keep N] # trim old backups (default keep 20)
  claude-toggle restore [latest|<file>]  # restore a ~/.claude.json backup (default: latest)

If neither --project nor --global is given, disable/enable acts on every
scope where the server is found (or stashed). Changes apply to NEW Claude
Code sessions only.
"""

import json
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path

VERSION = "1.5.0"

HOME = Path.home()
CLAUDE_JSON = HOME / ".claude.json"
SETTINGS_JSON = HOME / ".claude" / "settings.json"
GLOBAL_MD = HOME / ".claude" / "CLAUDE.md"
STASH = HOME / ".claude" / "mcp-disabled.json"
GROUPS = HOME / ".claude" / "toggle-groups.json"
BACKUPS = HOME / ".claude" / "backups"
PROFILES = HOME / ".claude" / "config-profiles"

GLOBAL = "__global__"
ALL = "--all"
KEEP_BACKUPS = 20
BACKUP_PATTERNS = ("claude.json.*", "settings.json.*", "CLAUDE.md.*")

# Directive blocks toggled in ~/.claude/CLAUDE.md. Markers must never change
# once shipped — on/off finds blocks by them. Keep blocks SHORT: this text is
# loaded into every session's context, so it is itself a token cost.
DIRECTIVES = {
    "squeeze": """## squeeze — output compression
Run potentially verbose commands (builds, tests, installs, big queries/logs) as
`squeeze -- <cmd>` (or `<cmd> 2>&1 | squeeze`; `--json` for JSON) so output enters
context compressed; error lines survive elision. Skip only when every line matters.""",
    "cindex": """## cindex — code search via index
To find functions/classes/files, run `cindex <query>` (also `file <pattern>`,
`grep <regex>`) before raw Grep — compact path:line results, auto-built index.
Then Read only that file:line. Fall back to Grep/Glob when cindex misses.""",
    "dbindex": """## dbindex — DB schema lookup
For "which database/table/column holds X": `dbindex <query>` or
`dbindex table <name>` — offline schema index of all vault connections, no VPN.
Use `db-conn` only for data queries; `dbindex build` after migrations.""",
    "csession": """## csession — past-session context
If the user references work not in this conversation: `csession <query>` then
`csession brief <id>` for a compact digest (never read transcript .jsonl).
"Continue or new session?" → relay `csession suggest "<task>"`. Work history →
`csession journal`. Never `csession prune --apply` without explicit confirmation.""",
}


def directive_markers(name):
    return (f"<!-- claude-toggle:{name}:start -->",
            f"<!-- claude-toggle:{name}:end -->")


def directive_block(name):
    start, end = directive_markers(name)
    return f"{start}\n{DIRECTIVES[name]}\n{end}"


def load(path, default):
    if path.exists():
        with open(path) as f:
            return json.load(f)
    return default


def save(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    tmp.replace(path)


def backup_file(src, prefix):
    BACKUPS.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    dest = BACKUPS / f"{prefix}.{stamp}"
    n = 1
    while dest.exists():
        dest = BACKUPS / f"{prefix}.{stamp}-{n}"
        n += 1
    shutil.copy2(src, dest)
    prune_backups(KEEP_BACKUPS)
    return dest


def backup_claude_json():
    return backup_file(CLAUDE_JSON, "claude.json")


def backup_settings_json():
    if not SETTINGS_JSON.exists():
        return None
    return backup_file(SETTINGS_JSON, "settings.json")


def prune_backups(keep):
    removed = 0
    for pattern in BACKUP_PATTERNS:
        found = sorted(BACKUPS.glob(pattern)) if BACKUPS.exists() else []
        for p in found[:-keep] if keep > 0 else found:
            p.unlink()
            removed += 1
    return removed


def warn_if_sessions_running():
    try:
        out = subprocess.run(["pgrep", "-fl", "claude"], capture_output=True, text=True).stdout
        procs = [l for l in out.splitlines() if "claude-toggle" not in l]
        if procs:
            print(f"note: {len(procs)} claude process(es) running — a session exiting "
                  "right now could overwrite this change (restore via 'claude-toggle restore').")
    except OSError:
        pass


def scopes(cfg):
    """Yield (scope_key, mcpServers dict) for global + each project.

    Read-only view: never inserts keys into cfg. Mutations pop from the
    returned dict, which is the live dict when it exists in cfg.
    """
    yield GLOBAL, cfg.get("mcpServers", {})
    for proj, pcfg in cfg.get("projects", {}).items():
        yield proj, pcfg.get("mcpServers", {})


def scope_label(key):
    return "global" if key == GLOBAL else key


def endpoint(sc):
    return sc.get("url") or " ".join([sc.get("command", "")] + sc.get("args", [])).strip() or "?"


def cmd_list():
    cfg = load(CLAUDE_JSON, {})
    stash = load(STASH, {})
    rows = []
    for key, servers in scopes(cfg):
        for name, sc in servers.items():
            rows.append((scope_label(key), name, "enabled", endpoint(sc)))
    for key, servers in stash.items():
        for name, sc in servers.items():
            rows.append((scope_label(key), name, "DISABLED", endpoint(sc)))
    if not rows:
        print("No MCP servers configured.")
        return
    w = max(len(r[0]) for r in rows)
    n = max(len(r[1]) for r in rows)
    print(f"{'SCOPE'.ljust(w)}  {'SERVER'.ljust(n)}  {'STATUS'.ljust(9)}  ENDPOINT")
    for scope, name, status, ep in sorted(rows):
        print(f"{scope.ljust(w)}  {name.ljust(n)}  {status.ljust(9)}  {ep}")


def pick_scopes(arg_scope):
    """Return a filter function over scope keys based on CLI args."""
    if arg_scope == GLOBAL:
        return lambda k: k == GLOBAL
    if arg_scope:
        return lambda k: k == arg_scope
    return lambda k: True


def match(server, name):
    if server == ALL:
        return True
    if isinstance(server, (list, set)):
        return name in server
    return server == name


def expand_server(server):
    """Resolve @group to its server list; plain names pass through."""
    if isinstance(server, str) and server.startswith("@"):
        groups = load(GROUPS, {})
        members = groups.get(server[1:])
        if not members:
            sys.exit(f"no group '{server[1:]}' — run 'claude-toggle group list'")
        return members
    return server


def cmd_group(action, rest):
    groups = load(GROUPS, {})
    if action == "list":
        if not groups:
            print("No groups. Create one: claude-toggle group set work atlassian zoho")
        for g, members in sorted(groups.items()):
            print(f"@{g}: {', '.join(members)}")
    elif action == "set":
        if len(rest) < 2:
            sys.exit("usage: claude-toggle group set <name> <server> [server...]")
        groups[rest[0].lstrip("@")] = rest[1:]
        save(GROUPS, groups)
        print(f"group @{rest[0].lstrip('@')} = {', '.join(rest[1:])}")
    elif action == "delete":
        if not rest or rest[0].lstrip("@") not in groups:
            sys.exit("usage: claude-toggle group delete <name>  (see 'group list')")
        del groups[rest[0].lstrip("@")]
        save(GROUPS, groups)
        print(f"deleted group @{rest[0].lstrip('@')}")
    else:
        sys.exit("usage: claude-toggle group set|list|delete ...")


def profile_matches(cfg, stash):
    """Names of saved profiles whose MCP snapshot equals the current state."""
    cur = (mcp_snapshot(cfg), stash)
    out = []
    for p in sorted(PROFILES.glob("*.json")) if PROFILES.exists() else []:
        prof = load(p, {})
        if (prof.get("mcp"), prof.get("stash", {})) == cur:
            out.append(p.stem)
    return out


def cmd_status():
    cfg = load(CLAUDE_JSON, {})
    stash = load(STASH, {})
    en = sum(len(s) for _, s in scopes(cfg))
    dis = sum(len(s) for s in stash.values())
    print(f"servers: {en} enabled, {dis} disabled")
    for key, servers in scopes(cfg):
        if servers:
            print(f"  {scope_label(key)}: {', '.join(sorted(servers))}")
    for key, servers in stash.items():
        if servers:
            print(f"  {scope_label(key)} (disabled): {', '.join(sorted(servers))}")
    matches = profile_matches(cfg, stash)
    print(f"profile: {'matches ' + ', '.join(matches) if matches else 'no saved profile matches'}")
    md = GLOBAL_MD.read_text() if GLOBAL_MD.exists() else ""
    states = [f"{n}={'on' if directive_markers(n)[0] in md else 'off'}" for n in DIRECTIVES]
    print(f"directives: {'  '.join(states)}")


def cmd_diff(name):
    pfile = PROFILES / f"{name}.json"
    if not pfile.exists():
        sys.exit(f"no profile named '{name}' — run 'claude-toggle profile list'")
    prof = load(pfile, {})
    cfg = load(CLAUDE_JSON, {})
    cur, want = mcp_snapshot(cfg), prof.get("mcp", {})

    def flat(snap):
        out = {}
        for n, sc in snap.get("mcpServers", {}).items():
            out[(GLOBAL, n)] = sc
        for proj, pdata in snap.get("projects", {}).items():
            for n, sc in pdata.get("mcpServers", {}).items():
                out[(proj, n)] = sc
        return out

    a, b = flat(cur), flat(want)
    changes = False
    for key in sorted(set(a) | set(b)):
        scope, n = scope_label(key[0]), key[1]
        if key not in b:
            print(f"- would remove '{n}' from {scope}"); changes = True
        elif key not in a:
            print(f"+ would add    '{n}' to {scope}"); changes = True
        elif a[key] != b[key]:
            print(f"~ would change '{n}' config in {scope}"); changes = True
    if load(STASH, {}) != prof.get("stash", {}):
        print("~ disabled-server stash would change"); changes = True
    if prof.get("settings", {}) != load(SETTINGS_JSON, {}):
        print("~ settings.json differs (only applied with --all)"); changes = True
    if not changes:
        print(f"profile '{name}' matches the current state — loading it would change nothing")


def cmd_disable(server, arg_scope):
    cfg = load(CLAUDE_JSON, {})
    stash = load(STASH, {})
    wanted = pick_scopes(arg_scope)
    moved = []
    for key, servers in scopes(cfg):
        if not wanted(key):
            continue
        for name in [n for n in servers if match(server, n)]:
            stash.setdefault(key, {})[name] = servers.pop(name)
            moved.append((key, name))
    if not moved:
        sys.exit(f"nothing to disable for '{server}' in the requested scope(s). Run 'claude-toggle list'.")
    print(f"backup: {backup_claude_json()}")
    save(STASH, stash)
    save(CLAUDE_JSON, cfg)
    for key, name in moved:
        print(f"disabled '{name}' in {scope_label(key)}")
    warn_if_sessions_running()
    print("Takes effect in new Claude Code sessions.")


def cmd_enable(server, arg_scope):
    cfg = load(CLAUDE_JSON, {})
    stash = load(STASH, {})
    wanted = pick_scopes(arg_scope)
    moved = []
    for key in list(stash.keys()):
        if not wanted(key):
            continue
        for name in [n for n in stash[key] if match(server, n)]:
            sc = stash[key].pop(name)
            if key == GLOBAL:
                cfg.setdefault("mcpServers", {})[name] = sc
            else:
                cfg.setdefault("projects", {}).setdefault(key, {}).setdefault("mcpServers", {})[name] = sc
            moved.append((key, name))
        if not stash[key]:
            del stash[key]
    if not moved:
        sys.exit(f"nothing to enable for '{server}' in the disabled stash. Run 'claude-toggle list'.")
    print(f"backup: {backup_claude_json()}")
    save(STASH, stash)
    save(CLAUDE_JSON, cfg)
    for key, name in moved:
        print(f"enabled '{name}' in {scope_label(key)}")
    warn_if_sessions_running()
    print("Takes effect in new Claude Code sessions.")


def mcp_snapshot(cfg):
    """Extract just the MCP-related parts of .claude.json."""
    snap = {"mcpServers": cfg.get("mcpServers", {}), "projects": {}}
    for proj, pcfg in cfg.get("projects", {}).items():
        if pcfg.get("mcpServers"):
            snap["projects"][proj] = {"mcpServers": pcfg["mcpServers"]}
    return snap


def cmd_profile(action, name=None, mode="mcp-only"):
    PROFILES.mkdir(parents=True, exist_ok=True)
    if action == "list":
        found = sorted(PROFILES.glob("*.json"))
        if not found:
            print("No saved profiles.")
        for p in found:
            meta = load(p, {})
            print(f"{p.stem}  (saved {meta.get('saved', '?')})")
        return
    if not name:
        sys.exit("profile save/load needs a name")
    pfile = PROFILES / f"{name}.json"
    if action == "save":
        cfg = load(CLAUDE_JSON, {})
        save(pfile, {
            "saved": datetime.now().isoformat(timespec="seconds"),
            "mcp": mcp_snapshot(cfg),
            "stash": load(STASH, {}),
            "settings": load(SETTINGS_JSON, {}),
        })
        print(f"saved profile '{name}' -> {pfile}")
    elif action == "load":
        if not pfile.exists():
            sys.exit(f"no profile named '{name}'")
        prof = load(pfile, {})
        applied = []
        if mode in ("mcp-only", "all"):
            cfg = load(CLAUDE_JSON, {})
            print(f"backup: {backup_claude_json()}")
            cfg["mcpServers"] = prof["mcp"].get("mcpServers", {})
            for proj, pdata in prof["mcp"].get("projects", {}).items():
                cfg.setdefault("projects", {}).setdefault(proj, {})["mcpServers"] = pdata["mcpServers"]
            save(CLAUDE_JSON, cfg)
            save(STASH, prof.get("stash", {}))
            applied.append("MCP config")
        if mode in ("settings-only", "all"):
            b = backup_settings_json()
            if b:
                print(f"settings backup: {b}")
            save(SETTINGS_JSON, prof.get("settings", {}))
            applied.append("settings.json")
        warn_if_sessions_running()
        print(f"loaded profile '{name}' (saved {prof.get('saved', '?')}): applied {' + '.join(applied)}.")
        if mode == "mcp-only":
            print("settings.json untouched — use --all to overwrite it from the profile.")
        print("Restart Claude Code sessions to apply.")
    else:
        sys.exit("profile action must be save, load, or list")


def cmd_directive(name, action):
    start_m, end_m = directive_markers(name)
    text = GLOBAL_MD.read_text() if GLOBAL_MD.exists() else ""
    enabled = start_m in text
    if action == "status":
        print(f"{name} directive: {'enabled' if enabled else 'disabled'} "
              f"({GLOBAL_MD}{'' if GLOBAL_MD.exists() else ' — file does not exist'})")
        return
    if action == "on":
        if enabled:
            print(f"{name} directive already enabled.")
            return
        if GLOBAL_MD.exists():
            print(f"backup: {backup_file(GLOBAL_MD, 'CLAUDE.md')}")
        new = text.rstrip() + ("\n\n" if text.strip() else "") + directive_block(name) + "\n"
        GLOBAL_MD.parent.mkdir(parents=True, exist_ok=True)
        GLOBAL_MD.write_text(new)
        print(f"{name} directive enabled in {GLOBAL_MD}")
    elif action == "off":
        if not enabled:
            print(f"{name} directive already disabled.")
            return
        print(f"backup: {backup_file(GLOBAL_MD, 'CLAUDE.md')}")
        start = text.index(start_m)
        end = text.index(end_m) + len(end_m)
        new = (text[:start].rstrip() + "\n\n" + text[end:].lstrip()).strip()
        GLOBAL_MD.write_text(new + "\n" if new else "")
        print(f"{name} directive removed from {GLOBAL_MD}")
    else:
        sys.exit(f"usage: claude-toggle {name} on|off|status")
    print("Takes effect in new Claude Code sessions.")


def list_backups():
    if not BACKUPS.exists():
        return []
    return sorted(BACKUPS.glob("claude.json.*"))


def all_backups():
    if not BACKUPS.exists():
        return []
    out = []
    for pattern in BACKUP_PATTERNS:
        out.extend(BACKUPS.glob(pattern))
    return sorted(out)


def cmd_backups():
    found = all_backups()
    if not found:
        print("No backups yet — one is created before every change.")
    for p in found:
        print(f"{p.name}  ({p.stat().st_size} bytes)")


def cmd_backups_prune(keep):
    removed = prune_backups(keep)
    remaining = len(all_backups())
    print(f"pruned {removed} backup(s), {remaining} kept (newest {keep} per file)")


def cmd_restore(which):
    found = list_backups()
    if not found:
        sys.exit("no backups to restore")
    if which in (None, "latest"):
        src = found[-1]
    else:
        src = BACKUPS / which
        if not src.exists():
            sys.exit(f"no backup named '{which}' — run 'claude-toggle backups'")
    # back up the current state too, so a restore is itself reversible
    print(f"pre-restore backup: {backup_claude_json()}")
    shutil.copy2(src, CLAUDE_JSON)
    print(f"restored ~/.claude.json from {src.name}")
    warn_if_sessions_running()


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    cmd = args[0]
    if cmd in ("-v", "--version", "version"):
        print(f"claude-toggle {VERSION}")
    elif cmd == "list":
        cmd_list()
    elif cmd in ("disable", "enable"):
        if len(args) < 2:
            sys.exit(f"usage: claude-toggle {cmd} <server>|--all [--project <path>|--global]")
        server, scope = expand_server(args[1]), None
        if "--global" in args[2:]:
            scope = GLOBAL
        if "--project" in args:
            i = args.index("--project")
            if i + 1 >= len(args):
                sys.exit("--project needs a path")
            scope = str(Path(args[i + 1]).expanduser().resolve())
        (cmd_disable if cmd == "disable" else cmd_enable)(server, scope)
    elif cmd == "status":
        cmd_status()
    elif cmd == "diff":
        if len(args) < 2:
            sys.exit("usage: claude-toggle diff <profile>")
        cmd_diff(args[1])
    elif cmd == "group":
        if len(args) < 2:
            sys.exit("usage: claude-toggle group set|list|delete ...")
        cmd_group(args[1], args[2:])
    elif cmd == "profile":
        if len(args) < 2:
            sys.exit("usage: claude-toggle profile save|load|list [name] [--all|--settings-only]")
        mode = "mcp-only"
        if "--all" in args[2:]:
            mode = "all"
        if "--settings-only" in args[2:]:
            mode = "settings-only"
        rest = [a for a in args[1:] if not a.startswith("--")]
        cmd_profile(rest[0], rest[1] if len(rest) > 1 else None, mode)
    elif cmd in DIRECTIVES:
        cmd_directive(cmd, args[1] if len(args) > 1 else "status")
    elif cmd == "backups":
        if len(args) > 1 and args[1] == "prune":
            keep = KEEP_BACKUPS
            if "--keep" in args:
                i = args.index("--keep")
                if i + 1 >= len(args) or not args[i + 1].isdigit():
                    sys.exit("--keep needs a number")
                keep = int(args[i + 1])
            cmd_backups_prune(keep)
        else:
            cmd_backups()
    elif cmd == "restore":
        cmd_restore(args[1] if len(args) > 1 else None)
    else:
        sys.exit(f"unknown command '{cmd}' — run 'claude-toggle help'")


if __name__ == "__main__":
    main()
