#!/usr/bin/env python3
"""claude-vault — private local store for credentials & personal config.

Secrets (DB credentials, API keys, tokens, personal settings) are stored in
the macOS Keychain — encrypted by the OS, never written to plaintext files,
never inside any git repo. Only an index of names/descriptions (no secret
values) is kept at ~/.claude/vault-index.json so entries can be listed.

Made to pair with AI sessions: tell Claude "use claude-vault get <name>"
and it can fetch a credential at the moment it needs it (e.g. to query a
database) without the value living in prompts, memory files, or configs.

Usage:
  claude-vault set <name> [--desc "text"]     # prompts for the secret (hidden)
  claude-vault set <name> --json              # prompts for a JSON blob, e.g.
                                              #   {"host":"..","user":"..","password":".."}
  claude-vault set <name> --password          # password-type: value is NEVER displayed
  claude-vault set <name> --field <key>       # update ONE field of a JSON secret
  claude-vault set <name> --stdin             # read the value from stdin (scripts/AI)
  claude-vault set <name> --from-clipboard    # take the value from the clipboard
  claude-vault get <name>                     # print the secret value (see below)
  claude-vault get <name> --field password    # print one field of a JSON secret
  claude-vault get <name> --copy              # put the value on the clipboard instead
  claude-vault rename <old> <new>             # rename an entry (value unchanged)
  claude-vault pin enable <name>              # PIN-lock an entry (default: no PIN)
  claude-vault pin disable <name>
  claude-vault list                           # names + descriptions only, no values
  claude-vault delete <name>
  claude-vault doctor [--fix]                 # reconcile Keychain vs index (adopt/prune drift)
  claude-vault test <name> | --all            # live-check DB credentials: ok / auth-failed /
                                              #   unreachable (VPN hint) — no values printed
  claude-vault import <file|-> --name <entry> [--map POSTGRES_HOST=host,...]
                                              # .env -> one JSON entry (kills paste-into-chat)
  claude-vault exec <name> [--prefix PG] -- <cmd> [args...]
                                              # run cmd with fields as env vars; the secret
                                              #   never transits the shell or transcript
  claude-vault set <name> --rotate-days 90    # staleness window: list/get warn once the
                                              #   entry is older than N days
  claude-vault desc <name> "text"             # edit the description without re-entering
  claude-vault get <name> --copy --clear 30   # clipboard, auto-cleared after N seconds
  claude-vault list --json                    # machine-readable (names/meta, no values)
  claude-vault completion zsh                 # print shell completion (entry names + commands)
  claude-vault help

Password-type entries are never printed to a terminal — only into a pipe or
command substitution ($(claude-vault get ...)), or onto the clipboard with
--copy. This lets scripts and AI sessions use them without a human (or a
screen-share audience) ever seeing the value.

Team convention — shared DB config, per-member passwords:
  prod-core-db                     JSON config: {"host":..,"port":..,"user":..}  (no password!)
  prod-core-db.<dbuser>            password-type entry, one per member
  prod-core-db.<dbuser>.ro / .rw   optional role variants (view-only vs update)
The core-db helper resolves these automatically (--user / --role flags).

PIN lock (optional, off by default): `pin enable <name>` encrypts the stored
value with a key derived from your PIN (PBKDF2-HMAC-SHA256, 200k iterations,
HMAC integrity check). Anyone with access to the Mac account then still needs
the PIN to read that entry. Each entry can have its own PIN.

Never pass the secret itself as a command-line argument — it would land in
shell history and `ps` output. Use the hidden prompt, --stdin, or --from-clipboard.
"""

import getpass
import hashlib
import hmac as hmac_mod
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path

VERSION = "1.5.0"
SERVICE_PREFIX = "claude-vault."
INDEX = Path.home() / ".claude" / "vault-index.json"
ACCOUNT = getpass.getuser()
PBKDF2_ITER = 200_000


def load_index():
    if INDEX.exists():
        with open(INDEX) as f:
            return json.load(f)
    return {}


def save_index(idx):
    INDEX.parent.mkdir(parents=True, exist_ok=True)
    tmp = INDEX.with_suffix(".tmp")
    with open(tmp, "w") as f:
        json.dump(idx, f, indent=2)
    tmp.replace(INDEX)
    INDEX.chmod(0o600)


def entry_type(meta):
    return meta.get("type") or ("json" if meta.get("json") else "plain")


def keychain(args, **kw):
    return subprocess.run(["security"] + args, capture_output=True, text=True, **kw)


def _security_quote(arg):
    """Quote one argument for the line parser of `security -i`.

    That parser splits a line on whitespace, groups text inside double quotes,
    and treats a backslash as "take the next character literally". Wrapping
    every argument in double quotes and backslash-escaping backslash and
    double quote is therefore exact. A newline would end the command line, so
    it (and NUL / CR) is refused rather than escaped.
    """
    if any(c in arg for c in ("\n", "\r", "\0")):
        raise ValueError("value contains a newline, carriage return or NUL")
    return '"' + arg.replace("\\", "\\\\").replace('"', '\\"') + '"'


def _kc_set_argv(args):
    """The original method: secret in argv. Proven on macOS; used only as a fallback."""
    return keychain(args)


def kc_set(name, value):
    # The secret must never appear in argv (visible to every user via `ps`).
    # `security -i` reads commands from stdin, so the whole add-generic-password
    # line — value included — travels through a pipe instead.
    args = [
        "add-generic-password", "-a", ACCOUNT, "-s", SERVICE_PREFIX + name,
        "-w", value, "-U",
        "-j", "stored by claude-vault",
    ]
    stdin_ok = False
    try:
        line = " ".join(_security_quote(a) for a in args) + "\n"
        r = keychain(["-i"], input=line)
        # in interactive mode `security` can exit 0 even when a command failed,
        # so a message on stderr counts as failure too; a read-back catches any
        # quoting surprise in the interactive parser
        stdin_ok = r.returncode == 0 and not r.stderr.strip() and kc_get(name) == value
    except (ValueError, OSError):
        stdin_ok = False
    if stdin_ok:
        return
    # Fail safe: rewrite with the original argv method so the stored value is
    # always correct. The only cost is the old exposure in `ps`, for this write.
    print(f"claude-vault: note: stdin write for '{name}' did not verify; "
          "stored with the original method instead", file=sys.stderr)
    r = _kc_set_argv(args)
    if r.returncode != 0:
        sys.exit(f"keychain error: {r.stderr.strip()}")
    # kc_get strips trailing newlines, so compare the same way
    if kc_get(name) != value.rstrip("\n"):
        sys.exit(f"keychain error: '{name}' did not read back as written")


def kc_get(name):
    r = keychain(["find-generic-password", "-a", ACCOUNT, "-s", SERVICE_PREFIX + name, "-w"])
    if r.returncode != 0:
        return None
    return r.stdout.rstrip("\n")


def kc_delete(name):
    r = keychain(["delete-generic-password", "-a", ACCOUNT, "-s", SERVICE_PREFIX + name])
    return r.returncode == 0


# ---------- PIN lock (PBKDF2 stream cipher + HMAC, stdlib only) ----------

def _derive(pin, salt, iters):
    key = hashlib.pbkdf2_hmac("sha256", pin.encode(), salt, iters, 64)
    return key[:32], key[32:]


def _keystream(enc_key, n):
    out = b""
    ctr = 0
    while len(out) < n:
        out += hashlib.sha256(enc_key + ctr.to_bytes(8, "big")).digest()
        ctr += 1
    return out[:n]


def pin_encrypt(value, pin):
    salt = os.urandom(16)
    enc_key, mac_key = _derive(pin, salt, PBKDF2_ITER)
    data = value.encode()
    ct = bytes(a ^ b for a, b in zip(data, _keystream(enc_key, len(data))))
    tag = hmac_mod.new(mac_key, salt + ct, hashlib.sha256).hexdigest()
    return json.dumps({"__pin__": 1, "iter": PBKDF2_ITER,
                       "salt": salt.hex(), "ct": ct.hex(), "tag": tag})


def is_pin_locked(raw):
    try:
        d = json.loads(raw)
        return isinstance(d, dict) and d.get("__pin__") == 1
    except (json.JSONDecodeError, TypeError):
        return False


def pin_decrypt(raw, pin):
    d = json.loads(raw)
    salt = bytes.fromhex(d["salt"])
    enc_key, mac_key = _derive(pin, salt, d.get("iter", PBKDF2_ITER))
    ct = bytes.fromhex(d["ct"])
    tag = hmac_mod.new(mac_key, salt + ct, hashlib.sha256).hexdigest()
    if not hmac_mod.compare_digest(tag, d["tag"]):
        sys.exit("wrong PIN")
    return bytes(a ^ b for a, b in zip(ct, _keystream(enc_key, len(ct)))).decode()


def read_pin(prompt):
    try:
        return getpass.getpass(prompt)
    except (EOFError, OSError):
        return sys.stdin.readline().strip()


def unlock(name, raw):
    """Return the plaintext value and the PIN used (None if not locked)."""
    if not is_pin_locked(raw):
        return raw, None
    pin = read_pin(f"PIN for '{name}': ")
    return pin_decrypt(raw, pin), pin


# ---------- value input ----------

def read_value(hidden_prompt, use_stdin, from_clipboard):
    if from_clipboard:
        r = subprocess.run(["pbpaste"], capture_output=True, text=True)
        if r.returncode != 0 or not r.stdout.strip():
            sys.exit("clipboard is empty or unreadable")
        return r.stdout.strip()
    if use_stdin or not sys.stdin.isatty():
        return sys.stdin.readline().strip()
    return getpass.getpass(hidden_prompt)


def offer_clipboard_clear():
    if sys.stdin.isatty():
        ans = input("Clear the clipboard now? [Y/n] ").strip().lower()
        if ans in ("", "y", "yes"):
            subprocess.run(["pbcopy"], input="", text=True)
            print("clipboard cleared")
    else:
        print("note: the secret is still on your clipboard — clear it with: pbcopy </dev/null")


# ---------- staleness (V5) + reference tracking (V8) ----------

def days_old(meta):
    try:
        return (datetime.now() - datetime.fromisoformat(meta.get("updated", ""))).days
    except ValueError:
        return None


def is_stale(meta):
    rd = meta.get("rotate_days")
    d = days_old(meta)
    return bool(rd) and d is not None and d >= rd


CONSUMERS_CFG = Path.home() / ".claude" / "vault-consumers.json"


def consumer_dirs():
    """Where to look for scripts that reference vault entry names."""
    if CONSUMERS_CFG.exists():
        try:
            return json.loads(CONSUMERS_CFG.read_text())
        except json.JSONDecodeError:
            pass
    return [str(Path(__file__).resolve().parent)]


def find_references(name):
    hits = []
    for d in consumer_dirs():
        root = Path(d).expanduser()
        files = [root] if root.is_file() else [
            f for f in root.rglob("*")
            if f.is_file() and f.stat().st_size < 1_000_000
            and not any(part in (".git", "Output", "node_modules", "__pycache__")
                        for part in f.parts)
            and f.suffix not in (".zip", ".png", ".jpg", ".pyc")]
        for f in files:
            try:
                text = f.read_text(errors="ignore")
            except (OSError, UnicodeDecodeError):
                continue
            for i, line in enumerate(text.splitlines(), 1):
                if name in line:
                    hits.append(f"{f}:{i}")
                    if len(hits) >= 12:
                        return hits
    return hits


def warn_references(name, verb):
    refs = find_references(name)
    if refs:
        print(f"warning: these files reference '{name}' — they may break after {verb}:",
              file=sys.stderr)
        for r in refs:
            print(f"  {r}", file=sys.stderr)


# ---------- commands ----------

def cmd_set(name, type_, desc, field=None, use_stdin=False, from_clipboard=False,
            rotate_days=None):
    idx = load_index()
    existing_raw = kc_get(name)
    pin = None
    if field:
        if existing_raw is None:
            sys.exit(f"no secret named '{name}' — --field updates an existing JSON secret")
        current, pin = unlock(name, existing_raw)
        try:
            data = json.loads(current)
        except json.JSONDecodeError:
            sys.exit(f"'{name}' is not a JSON secret — cannot update field '{field}'")
        new = read_value(f"New value for '{field}' (hidden): ", use_stdin, from_clipboard)
        if not new:
            sys.exit("empty value — nothing stored")
        data[field] = new
        value = json.dumps(data)
        type_ = entry_type(idx.get(name, {"type": "json"}))
        done = f"updated field '{field}' of '{name}' in macOS Keychain"
    else:
        if type_ is None:
            # no explicit --json/--password: keep the existing entry's type
            type_ = entry_type(idx[name]) if name in idx else "plain"
        if existing_raw is not None and is_pin_locked(existing_raw):
            # verify the PIN before overwriting; the entry stays locked with it
            _, pin = unlock(name, existing_raw)
        if type_ == "json" and not from_clipboard:
            print("Paste the JSON value (one line), e.g. {\"host\":\"..\",\"user\":\"..\",\"password\":\"..\"}:",
                  file=sys.stderr)
        prompt = {"json": "JSON value (hidden): ",
                  "password": "Password value (hidden): "}.get(type_, "Secret value (hidden): ")
        value = read_value(prompt, use_stdin, from_clipboard)
        if not value:
            sys.exit("empty value — nothing stored")
        if type_ == "json":
            try:
                json.loads(value)
            except json.JSONDecodeError as e:
                sys.exit(f"not valid JSON: {e}")
        if type_ == "password":
            done = f"stored '{name}' in macOS Keychain (password value, length hidden)"
        else:
            done = f"stored '{name}' in macOS Keychain ({type_} value, {len(value)} chars)"
    if pin:
        value = pin_encrypt(value, pin)
    kc_set(name, value)
    idx[name] = {
        "desc": desc or idx.get(name, {}).get("desc", ""),
        "type": type_,
        "pin": bool(pin),
        "updated": datetime.now().isoformat(timespec="seconds"),
    }
    rd = rotate_days if rotate_days is not None else load_index().get(name, {}).get("rotate_days")
    if rd:
        idx[name]["rotate_days"] = rd
    save_index(idx)
    print(done)
    if from_clipboard:
        offer_clipboard_clear()


def cmd_get(name, field, copy=False, clear_after=None):
    raw = kc_get(name)
    if raw is None:
        sys.exit(f"no secret named '{name}' — run 'claude-vault list'")
    meta = load_index().get(name, {})
    if is_stale(meta):
        print(f"warning: '{name}' is {days_old(meta)} days old "
              f"(rotation window {meta['rotate_days']}d) — rotate it", file=sys.stderr)
    value, _ = unlock(name, raw)
    if field:
        try:
            data = json.loads(value)
        except json.JSONDecodeError:
            sys.exit(f"'{name}' is not a JSON secret — cannot extract field '{field}'")
        if field not in data:
            sys.exit(f"'{name}' has no field '{field}' (fields: {', '.join(data.keys())})")
        value = data[field]
        if not isinstance(value, str):
            value = json.dumps(value)
    if copy:
        subprocess.run(["pbcopy"], input=value, text=True)
        if clear_after:
            subprocess.Popen(["/bin/sh", "-c", f"sleep {int(clear_after)}; pbcopy </dev/null"],
                             start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print(f"'{name}' copied to clipboard — auto-clearing in {int(clear_after)}s",
                  file=sys.stderr)
        else:
            print(f"'{name}' copied to clipboard — clear it later with: pbcopy </dev/null",
                  file=sys.stderr)
        return
    if entry_type(meta) == "password" and sys.stdout.isatty():
        sys.exit(f"'{name}' is a password-type entry — its value is never displayed.\n"
                 f"Use it inside a command: $(claude-vault get {name})   or: claude-vault get {name} --copy")
    if not sys.stdout.isatty() and not os.environ.get("CLAUDE_VAULT_QUIET"):
        # stdout is a pipe or file: in an AI session that is usually the tool
        # output, i.e. the transcript. exec is the path that keeps it out.
        print(f"claude-vault: warning: writing '{name}' to a non-terminal stdout — "
              "if an AI session captures this output, the value lands in its transcript.\n"
              f"  agent-safe: claude-vault exec {name} [--prefix P] -- <cmd>   "
              "(set CLAUDE_VAULT_QUIET=1 to silence in trusted scripts)",
              file=sys.stderr)
    print(value)


def cmd_list(as_json=False):
    idx = load_index()
    if as_json:
        out = []
        for name, meta in sorted(idx.items()):
            out.append({"name": name, "type": entry_type(meta), "pin": bool(meta.get("pin")),
                        "updated": meta.get("updated"), "desc": meta.get("desc", ""),
                        "rotate_days": meta.get("rotate_days"), "stale": is_stale(meta)})
        print(json.dumps(out, indent=2))
        return
    if not idx:
        print("Vault is empty. Add one with: claude-vault set <name>")
        return
    w = max(max(len(n) for n in idx), 4)
    t = max(max(len(entry_type(m)) for m in idx.values()), 4)
    print(f"{'NAME'.ljust(w)}  {'TYPE'.ljust(t)}  {'PIN'.ljust(3)}  {'UPDATED'.ljust(19)}  DESCRIPTION")
    for name, meta in sorted(idx.items()):
        pin = "yes" if meta.get("pin") else "-"
        print(f"{name.ljust(w)}  {entry_type(meta).ljust(t)}  {pin.ljust(3)}  "
              f"{meta.get('updated', '?').ljust(19)}  {meta.get('desc', '')}")
    for name, meta in sorted(idx.items()):
        if is_stale(meta):
            print(f"warning: '{name}' is {days_old(meta)} days old "
                  f"(rotation window {meta['rotate_days']}d) — rotate it", file=sys.stderr)


def cmd_desc(name, text):
    idx = load_index()
    if name not in idx:
        sys.exit(f"no secret named '{name}' — run 'claude-vault list'")
    idx[name]["desc"] = text
    save_index(idx)
    print(f"description of '{name}' updated")


def cmd_completion(shell):
    if shell != "zsh":
        sys.exit("only zsh completion is provided — usage: claude-vault completion zsh")
    print("""# claude-vault zsh completion — add to ~/.zshrc:
#   source <(claude-vault completion zsh)
_claude_vault() {
  local -a cmds
  cmds=(set get list delete rename desc doctor test import exec pin completion help version)
  if (( CURRENT == 2 )); then
    compadd -a cmds
  else
    compadd $(claude-vault _names 2>/dev/null)
  fi
}
compdef _claude_vault claude-vault""")


def cmd_rename(old, new):
    if old == new:
        sys.exit("old and new names are the same")
    value = kc_get(old)
    if value is None:
        sys.exit(f"no secret named '{old}' — run 'claude-vault list'")
    if kc_get(new) is not None:
        sys.exit(f"'{new}' already exists — delete it first if you really mean to overwrite")
    kc_set(new, value)
    idx = load_index()
    meta = idx.pop(old, None)
    if meta is None:
        # entry existed only in the Keychain (index drift) — rebuild minimal meta
        try:
            json.loads(value)
            is_json = True
        except json.JSONDecodeError:
            is_json = False
        meta = {"desc": "", "type": "json" if is_json else "plain", "pin": is_pin_locked(value)}
    meta["updated"] = datetime.now().isoformat(timespec="seconds")
    idx[new] = meta
    save_index(idx)
    kc_delete(old)
    print(f"renamed '{old}' -> '{new}'")
    warn_references(old, "this rename")


def cmd_pin(action, name):
    raw = kc_get(name)
    if raw is None:
        sys.exit(f"no secret named '{name}' — run 'claude-vault list'")
    idx = load_index()
    meta = idx.setdefault(name, {"desc": "", "type": "plain"})
    if action == "enable":
        if is_pin_locked(raw):
            sys.exit(f"'{name}' is already PIN-locked")
        pin = read_pin(f"New PIN for '{name}': ")
        pin2 = read_pin("Repeat PIN: ")
        if not pin:
            sys.exit("empty PIN — nothing changed")
        if pin != pin2:
            sys.exit("PINs do not match — nothing changed")
        kc_set(name, pin_encrypt(raw, pin))
        meta["pin"] = True
        print(f"PIN enabled for '{name}' — reads now require the PIN. Don't lose it: "
              "the value cannot be recovered without it.")
    elif action == "disable":
        if not is_pin_locked(raw):
            sys.exit(f"'{name}' is not PIN-locked")
        pin = read_pin(f"PIN for '{name}': ")
        kc_set(name, pin_decrypt(raw, pin))
        meta["pin"] = False
        print(f"PIN disabled for '{name}'")
    else:
        sys.exit("usage: claude-vault pin enable|disable <name>")
    meta["updated"] = datetime.now().isoformat(timespec="seconds")
    save_index(idx)


def cmd_delete(name):
    existed = kc_delete(name)
    idx = load_index()
    in_index = name in idx
    if in_index:
        del idx[name]
        save_index(idx)
    if not existed and not in_index:
        sys.exit(f"no secret named '{name}'")
    print(f"deleted '{name}'")
    warn_references(name, "this delete")


def kc_all_names():
    """All claude-vault.* service names present in the login Keychain."""
    r = keychain(["dump-keychain"])
    pat = r'"svce"<blob>="' + re.escape(SERVICE_PREFIX) + r'([^"]+)"'
    return sorted(set(re.findall(pat, r.stdout)))


def cmd_doctor(fix=False):
    idx = load_index()
    kc = kc_all_names()
    only_kc = [n for n in kc if n not in idx]
    only_idx = [n for n in idx if n not in kc]
    bad_json = []
    for n, m in idx.items():
        if entry_type(m) == "json" and not m.get("pin") and n in kc:
            raw = kc_get(n)
            if raw is not None and not is_pin_locked(raw):
                try:
                    json.loads(raw)
                except json.JSONDecodeError:
                    bad_json.append(n)
    if not (only_kc or only_idx or bad_json):
        print(f"doctor: Keychain and index agree ({len(idx)} entries), all JSON entries parse.")
        return
    for n in only_kc:
        print(f"in Keychain but not index: '{n}'" + ("  -> adopting" if fix else ""))
        if fix:
            raw = kc_get(n) or ""
            if is_pin_locked(raw):
                t, pin = "plain", True
            else:
                try:
                    json.loads(raw)
                    t, pin = "json", False
                except json.JSONDecodeError:
                    t, pin = "plain", False
            idx[n] = {"desc": "(adopted by doctor)", "type": t, "pin": pin,
                      "updated": datetime.now().isoformat(timespec="seconds")}
    for n in only_idx:
        print(f"in index but not Keychain: '{n}'" + ("  -> pruning" if fix else ""))
        if fix:
            del idx[n]
    for n in bad_json:
        print(f"json-typed entry does not parse as JSON: '{n}' (fix with: claude-vault set {n} --json)")
    if fix:
        save_index(idx)
        print("doctor: fixed.")
    elif only_kc or only_idx:
        print("run 'claude-vault doctor --fix' to adopt/prune.")


def test_entry(name):
    raw = kc_get(name)
    if raw is None:
        return "missing from Keychain (doctor)"
    if is_pin_locked(raw):
        return "pin-locked — skipped"
    try:
        cfg = json.loads(raw)
    except json.JSONDecodeError:
        return "not JSON — skipped"
    host, user = cfg.get("host"), cfg.get("user")
    if not host:
        return "no host field — skipped"
    port = str(cfg.get("port") or "")
    engine = cfg.get("engine") or ("mysql" if port == "3306" else "postgres")
    port = port or ("3306" if engine == "mysql" else "5432")
    if subprocess.run(["nc", "-z", "-G", "3", host, port], capture_output=True).returncode != 0:
        return f"UNREACHABLE {host}:{port} — private endpoint? connect to the VPN"
    pw = cfg.get("password")
    for suffix in (f".{user}", f".{user}.rw", f".{user}.ro"):
        if pw:
            break
        cand = kc_get(name + suffix)
        if cand and not is_pin_locked(cand):
            pw = cand
    if not pw:
        return f"reachable {host}:{port} — no password entry to auth-test"
    client = "psql" if engine == "postgres" else "mysql"
    if not shutil.which(client):
        return f"reachable — '{client}' client not installed, cannot auth-test"
    db = cfg.get("database") or ("postgres" if engine == "postgres" else "")
    env = dict(os.environ)
    if engine == "postgres":
        env.update(PGPASSWORD=pw, PGCONNECT_TIMEOUT="5")
        r = subprocess.run(["psql", "-h", host, "-p", port, "-U", user,
                            "-d", db or "postgres", "-tAc", "SELECT 1"],
                           capture_output=True, text=True, env=env)
    else:
        env.update(MYSQL_PWD=pw)
        r = subprocess.run(["mysql", "-h", host, "-P", port, "-u", user, "--protocol=TCP",
                            *([db] if db else []), "-e", "SELECT 1"],
                           capture_output=True, text=True, env=env)
    if r.returncode == 0:
        return "ok"
    err = (r.stderr.strip().splitlines() or ["auth failed"])[-1]
    return f"AUTH FAILED: {err[:90]}"


def cmd_test(name, all_):
    idx = load_index()
    targets = ([name] if name else
               [n for n, m in sorted(idx.items()) if entry_type(m) == "json"])
    if not targets:
        sys.exit("nothing to test — no JSON entries" if all_ else "usage: claude-vault test <name>|--all")
    w = max(len(n) for n in targets)
    for n in targets:
        print(f"{n.ljust(w)}  {test_entry(n)}")


DEFAULT_ENV_MAP = {"HOST": "host", "PORT": "port", "USER": "user", "USERNAME": "user",
                   "PASSWORD": "password", "PASS": "password", "DATABASE": "database",
                   "DB": "database", "NAME": "database", "ENGINE": "engine"}
ENV_PREFIXES = ("POSTGRES_", "POSTGRESQL_", "MYSQL_", "PG_", "PG", "DB_", "DATABASE_")


def cmd_import(path, name, map_arg, desc):
    text = sys.stdin.read() if path == "-" else Path(path).read_text()
    mapping = {}
    if map_arg:
        for pair in map_arg.split(","):
            if "=" not in pair:
                sys.exit(f"--map entries must be ENVKEY=field, got '{pair}'")
            k, v = pair.split("=", 1)
            mapping[k.strip()] = v.strip()
    data, unmapped = {}, []
    for line in text.splitlines():
        s = line.strip()
        m = re.match(r"(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)$", s)
        if not s or s.startswith("#") or not m:
            continue
        key, val = m.group(1), m.group(2).strip().strip("'\"")
        if key in mapping:
            data[mapping[key]] = val
            continue
        base = key
        for p in ENV_PREFIXES:
            if base.startswith(p):
                base = base[len(p):]
                break
        if base in DEFAULT_ENV_MAP:
            data[DEFAULT_ENV_MAP[base]] = val
        else:
            unmapped.append(key)
    if not data:
        sys.exit("no recognizable variables found — use --map ENVKEY=field,...")
    kc_set(name, json.dumps(data))
    idx = load_index()
    idx[name] = {"desc": desc or f"imported from {path}", "type": "json", "pin": False,
                 "updated": datetime.now().isoformat(timespec="seconds")}
    save_index(idx)
    print(f"stored '{name}' with fields: {', '.join(sorted(data))}")
    if unmapped:
        print(f"ignored (no mapping): {', '.join(unmapped)}")
    if path != "-":
        print(f"the plaintext file still exists — consider: rm {path}")


def cmd_exec(name, prefix, cmd_args):
    raw = kc_get(name)
    if raw is None:
        sys.exit(f"no secret named '{name}' — run 'claude-vault list'")
    value, _ = unlock(name, raw)
    env = dict(os.environ)
    try:
        data = json.loads(value)
        if not isinstance(data, dict):
            raise ValueError
    except (json.JSONDecodeError, ValueError):
        data = None
    if data is not None:
        for k, v in data.items():
            env[(prefix or "") + str(k).upper()] = str(v)
    else:
        env[prefix or name.upper().replace("-", "_").replace(".", "_")] = value
    try:
        os.execvpe(cmd_args[0], cmd_args, env)
    except FileNotFoundError:
        sys.exit(f"exec: command not found: {cmd_args[0]}")


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    cmd = args[0]
    if cmd in ("-v", "--version", "version"):
        print(f"claude-vault {VERSION}")
        return
    if sys.platform != "darwin":
        sys.exit("claude-vault uses the macOS Keychain and only runs on macOS")
    if cmd == "set":
        if len(args) < 2 or args[1].startswith("--"):
            sys.exit("usage: claude-vault set <name> [--json|--password] [--field <key>] "
                     "[--stdin] [--from-clipboard] [--desc \"text\"]")
        name = args[1]
        as_json = "--json" in args
        as_password = "--password" in args
        if as_json and as_password:
            sys.exit("--json and --password are mutually exclusive")
        type_ = "json" if as_json else "password" if as_password else None
        use_stdin = "--stdin" in args
        from_clipboard = "--from-clipboard" in args
        if use_stdin and from_clipboard:
            sys.exit("--stdin and --from-clipboard are mutually exclusive")
        desc = ""
        if "--desc" in args:
            i = args.index("--desc")
            if i + 1 >= len(args):
                sys.exit("--desc needs a value")
            desc = args[i + 1]
        field = None
        if "--field" in args:
            i = args.index("--field")
            if i + 1 >= len(args):
                sys.exit("--field needs a key")
            field = args[i + 1]
        rotate_days = None
        if "--rotate-days" in args:
            i = args.index("--rotate-days")
            if i + 1 >= len(args) or not args[i + 1].isdigit():
                sys.exit("--rotate-days needs a number")
            rotate_days = int(args[i + 1])
        cmd_set(name, type_, desc, field, use_stdin, from_clipboard, rotate_days)
    elif cmd == "get":
        if len(args) < 2:
            sys.exit("usage: claude-vault get <name> [--field <key>] [--copy [--clear N]]")
        field = None
        if "--field" in args:
            i = args.index("--field")
            if i + 1 >= len(args):
                sys.exit("--field needs a key")
            field = args[i + 1]
        clear_after = None
        if "--clear" in args:
            i = args.index("--clear")
            if i + 1 >= len(args) or not args[i + 1].isdigit():
                sys.exit("--clear needs a number of seconds")
            clear_after = int(args[i + 1])
        cmd_get(args[1], field, copy="--copy" in args, clear_after=clear_after)
    elif cmd == "desc":
        if len(args) < 3:
            sys.exit('usage: claude-vault desc <name> "text"')
        cmd_desc(args[1], args[2])
    elif cmd == "completion":
        cmd_completion(args[1] if len(args) > 1 else "zsh")
    elif cmd == "_names":
        print("\n".join(sorted(load_index())))
    elif cmd == "rename":
        if len(args) < 3:
            sys.exit("usage: claude-vault rename <old> <new>")
        cmd_rename(args[1], args[2])
    elif cmd == "pin":
        if len(args) < 3:
            sys.exit("usage: claude-vault pin enable|disable <name>")
        cmd_pin(args[1], args[2])
    elif cmd == "list":
        cmd_list(as_json="--json" in args)
    elif cmd == "doctor":
        cmd_doctor(fix="--fix" in args)
    elif cmd == "test":
        all_ = "--all" in args
        name = args[1] if len(args) > 1 and not args[1].startswith("--") else None
        cmd_test(name, all_)
    elif cmd == "import":
        if len(args) < 2:
            sys.exit("usage: claude-vault import <file|-> --name <entry> "
                     "[--map ENVKEY=field,...] [--desc \"text\"]")
        name = map_arg = desc = None
        for flag in ("--name", "--map", "--desc"):
            if flag in args:
                i = args.index(flag)
                if i + 1 >= len(args):
                    sys.exit(f"{flag} needs a value")
                val = args[i + 1]
                name = val if flag == "--name" else name
                map_arg = val if flag == "--map" else map_arg
                desc = val if flag == "--desc" else desc
        if not name:
            sys.exit("import needs --name <entry>")
        cmd_import(args[1], name, map_arg, desc)
    elif cmd == "exec":
        if "--" not in args or len(args) < 2:
            sys.exit("usage: claude-vault exec <name> [--prefix PG] -- <cmd> [args...]")
        sep = args.index("--")
        head, cmd_args = args[1:sep], args[sep + 1:]
        if not head or not cmd_args:
            sys.exit("usage: claude-vault exec <name> [--prefix PG] -- <cmd> [args...]")
        prefix = None
        if "--prefix" in head:
            i = head.index("--prefix")
            if i + 1 >= len(head):
                sys.exit("--prefix needs a value")
            prefix = head[i + 1]
        cmd_exec(head[0], prefix, cmd_args)
    elif cmd == "delete":
        if len(args) < 2:
            sys.exit("usage: claude-vault delete <name>")
        cmd_delete(args[1])
    else:
        sys.exit(f"unknown command '{cmd}' — run 'claude-vault help'")


if __name__ == "__main__":
    main()
