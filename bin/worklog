#!/usr/bin/env python3
# worklog — offline daily work-log generator (zero tokens).
#
# Builds a per-day summary of what was actually worked on from two local
# sources — the csession session index (~/.claude/session-index/index.json)
# and git commits across ~/Workspace repos — and writes it to
# Output/worklog/<YYYY-MM-DD>.md with machine-readable frontmatter so
# weekly/monthly reports can be generated from the files.
#
# No AI session is involved: the automation runs this for free; the worklog
# *skill* layers narrative summary and improvement suggestions on top.
#
# Usage:
#   worklog generate [--date YYYY-MM-DD] [--force]   # write one day's log
#   worklog check          # automation entry point:
#                          #   - backfill: last 7 days (weekend/leave-safe —
#                          #     days with no activity are skipped, not flagged)
#                          #   - today: only generated after 21:00
#   worklog week [--date YYYY-MM-DD]   # aggregate the 7 days ending <date>
#   worklog status         # which recent days have logs / activity
#
# Log location: <repo>/Output/worklog/  (gitignored — personal data)

import json
import re
import subprocess
import sys
import time
from datetime import date, datetime, timedelta
from pathlib import Path

VERSION = "1.0.0"
REPO = Path(__file__).resolve().parents[2]
OUT = REPO / "Output" / "worklog"
SESSION_INDEX = Path.home() / ".claude" / "session-index" / "index.json"
WORKSPACE = Path.home() / "Workspace"
EOD_HOUR = 21          # "after 9" — today's log is only auto-written after 21:00
LOOKBACK_DAYS = 7      # covers weekends / long offs
BIG_SESSION_TOK = 150_000
BIG_DAY_TOK = 500_000


def sh(args, cwd=None):
    r = subprocess.run(args, capture_output=True, text=True, cwd=cwd)
    return r.stdout.strip() if r.returncode == 0 else ""


def load_sessions():
    # refresh the index first (cheap, incremental) so today's sessions appear
    subprocess.run(["csession", "build"], capture_output=True)
    if not SESSION_INDEX.exists():
        return {}
    try:
        return json.loads(SESSION_INDEX.read_text())
    except ValueError:
        return {}


def sessions_for(idx, day):
    out = []
    for sid, r in idx.items():
        if (r.get("start") or "").startswith(day) and r.get("prompts"):
            out.append((sid, r))
    return sorted(out, key=lambda kv: kv[1].get("start") or "")


def git_email():
    return sh(["git", "config", "--get", "user.email"]) or ""


def commits_for(day):
    email = git_email()
    out = []
    for d in sorted(WORKSPACE.glob("*/")):
        if not (d / ".git").exists():
            continue
        args = ["git", "-C", str(d), "log", "--all", "--no-merges",
                f"--since={day} 00:00", f"--until={day} 23:59",
                "--pretty=%h %s"]
        if email:
            args.insert(4, f"--author={email}")
        for line in sh(args).splitlines():
            out.append((d.name.rstrip("/"), line))
    return out


def tokens_of(rec):
    return rec.get("bytes", 0) // 4


def title_of(rec):
    return rec.get("title") or (rec["prompts"][0][:60] if rec.get("prompts") else "(untitled)")


def project_of(rec):
    return (rec.get("project") or "?").rsplit("/", 1)[-1]


def flags_for(sessions, commits):
    flags = []
    total = sum(tokens_of(r) for _, r in sessions)
    for sid, r in sessions:
        if tokens_of(r) > BIG_SESSION_TOK:
            flags.append(f"Session {sid[:8]} ({title_of(r)[:40]}) ran ~{tokens_of(r) // 1000}k "
                         "tokens — consider /clear between task pivots and `csession brief` to re-seed.")
    if total > BIG_DAY_TOK:
        flags.append(f"Day total ~{total // 1000}k transcript tokens across {len(sessions)} "
                     "sessions — batching related asks into fewer prompts would cut rereads.")
    tiny = [s for s, r in sessions if len(r.get("prompts", [])) == 1 and tokens_of(r) < 10_000]
    if len(tiny) >= 3:
        flags.append(f"{len(tiny)} one-question sessions — consider batching quick asks into one session.")
    coding = [1 for _, r in sessions if "Workspace" in (r.get("project") or "")]
    if coding and not commits:
        flags.append("Coding sessions but no commits today — uncommitted work is one crash from lost.")
    return flags


def generate(idx, day, force=False):
    path = OUT / f"{day}.md"
    if path.exists() and not force:
        return None
    sessions = sessions_for(idx, day)
    commits = commits_for(day)
    if not sessions and not commits:
        return None  # no activity: weekend / leave — nothing to log
    total_tok = sum(tokens_of(r) for _, r in sessions)
    projects = sorted({project_of(r) for _, r in sessions} | {c[0] for c in commits})
    files = []
    for _, r in sessions:
        for f in r.get("files", []):
            if f not in files:
                files.append(f)
    flags = flags_for(sessions, commits)

    lines = ["---",
             f"date: {day}",
             f"sessions: {len(sessions)}",
             f"commits: {len(commits)}",
             f"transcript_tokens: {total_tok}",
             f"projects: [{', '.join(projects)}]",
             "---", "",
             f"# Work Log — {day}", "",
             "## Sessions"]
    for sid, r in sessions:
        t = (r.get("start") or "")[11:16]
        lines.append(f"- {t}  **{project_of(r)}** — {title_of(r)} "
                     f"({len(r.get('prompts', []))} tasks, ~{tokens_of(r) // 1000}k tok)")
    if commits:
        lines += ["", "## Commits"]
        for repo, c in commits:
            lines.append(f"- {repo}: {c}")
    if files:
        lines += ["", "## Files touched"]
        lines += [f"- {f}" for f in files[:25]]
    if flags:
        lines += ["", "## Flags (auto)"]
        lines += [f"- {f}" for f in flags]
    OUT.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines) + "\n")
    return path


def day_str(d):
    return d.strftime("%Y-%m-%d")


def cmd_check():
    idx = load_sessions()
    today = date.today()
    made, skipped = [], 0
    for i in range(1, LOOKBACK_DAYS + 1):
        d = day_str(today - timedelta(days=i))
        p = generate(idx, d)
        if p:
            made.append(p.name)
        elif not (OUT / f"{d}.md").exists():
            skipped += 1  # no activity that day
    if datetime.now().hour >= EOD_HOUR:
        p = generate(idx, day_str(today), force=True)
        if p:
            made.append(p.name)
    if made:
        print(f"worklog: wrote {', '.join(made)}")
    else:
        print(f"worklog: up to date ({skipped} inactive day(s) in lookback)")


def cmd_week(end_day):
    end = datetime.strptime(end_day, "%Y-%m-%d").date()
    days = [day_str(end - timedelta(days=i)) for i in range(6, -1, -1)]
    tot = {"sessions": 0, "commits": 0, "tokens": 0}
    projects, day_lines, all_flags = set(), [], []
    for d in days:
        p = OUT / f"{d}.md"
        if not p.exists():
            continue
        text = p.read_text()
        m = re.search(r"sessions: (\d+)\ncommits: (\d+)\ntranscript_tokens: (\d+)\nprojects: \[(.*?)\]", text)
        if m:
            tot["sessions"] += int(m.group(1))
            tot["commits"] += int(m.group(2))
            tot["tokens"] += int(m.group(3))
            projects |= {x.strip() for x in m.group(4).split(",") if x.strip()}
        body = text.split("---", 2)[-1].strip()
        day_lines.append(body.replace("# Work Log — ", "## "))
        all_flags += re.findall(r"^- (.*)$", text.split("## Flags (auto)")[-1], re.M) \
            if "## Flags (auto)" in text else []
    if not day_lines:
        print(f"no logs in the 7 days ending {end_day} — run 'worklog check' first")
        return
    out = [f"# Weekly Work Report — {days[0]} … {days[-1]}", "",
           f"**{tot['sessions']} sessions · {tot['commits']} commits · "
           f"~{tot['tokens'] // 1000}k transcript tokens · projects: {', '.join(sorted(projects))}**", ""]
    out += day_lines
    if all_flags:
        out += ["", "## All flags this week"] + [f"- {f}" for f in dict.fromkeys(all_flags)]
    path = OUT / f"week-{days[-1]}.md"
    path.write_text("\n".join(out) + "\n")
    print(path)


def cmd_status():
    today = date.today()
    for i in range(LOOKBACK_DAYS, -1, -1):
        d = day_str(today - timedelta(days=i))
        p = OUT / f"{d}.md"
        print(f"{d}  {'logged' if p.exists() else 'no log'}")


def main():
    args = sys.argv[1:]
    opts = {"date": day_str(date.today()), "force": False}
    pos = []
    i = 0
    while i < len(args):
        if args[i] == "--date":
            opts["date"] = args[i + 1]; i += 2
        elif args[i] == "--force":
            opts["force"] = True; i += 1
        elif args[i] in ("-h", "--help", "help"):
            print(open(__file__).read().split("\n\nimport")[0]
                  .replace("#!/usr/bin/env python3\n", "").replace("# ", "").replace("#", ""))
            return
        elif args[i] in ("-v", "--version", "version"):
            print(f"worklog {VERSION}")
            return
        else:
            pos.append(args[i]); i += 1
    cmd = pos[0] if pos else "check"
    if cmd == "generate":
        p = generate(load_sessions(), opts["date"], opts["force"])
        print(p or f"no activity on {opts['date']} (or log exists — use --force)")
    elif cmd == "check":
        cmd_check()
    elif cmd == "week":
        cmd_week(opts["date"])
    elif cmd == "status":
        cmd_status()
    else:
        sys.exit(f"worklog: unknown command '{cmd}' — see --help")


if __name__ == "__main__":
    main()
