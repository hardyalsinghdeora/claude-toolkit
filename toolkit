#!/usr/bin/env python3
# toolkit — install and health-check the whole claude-toolkit.
#
# Exists because of a real incident: the repo moved from ~/Desktop to
# ~/Workspace and every ~/.local/bin symlink silently broke — claude-vault
# and db-conn were dead on PATH for days before anyone noticed. One command
# now re-links everything, and one command verifies the whole install.
#
# Usage:
#   toolkit install [--bin DIR]   # (re)link every tool into ~/.local/bin
#   toolkit doctor                # verify links, versions, PATH, launchd agents,
#                                 #   directive freshness, indexes, vault health
#   toolkit list                  # the tools this repo provides
#
# doctor exits non-zero when something is broken, so it can gate automation.

import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

VERSION = "1.0.0"
REPO = Path(__file__).resolve().parent
DEFAULT_BIN = Path.home() / ".local" / "bin"
LAUNCH_AGENTS = Path.home() / "Library" / "LaunchAgents"

# name -> path within the repo
TOOLS = {
    "claude-toggle": "claude-toggle",
    "claude-vault": "claude-vault",
    "db-conn": "db-conn",
    "squeeze": "squeeze",
    "cindex": "cindex",
    "dbindex": "dbindex",
    "csession": "csession",
    "atl": "Scripts/atlassian/atl",
    "worklog": "Scripts/worklog/worklog",
}

INDEXES = {
    "code-index": Path.home() / ".claude" / "code-index" / "indexes",
    "db-index": Path.home() / ".claude" / "db-index" / "indexes",
    "session-index": Path.home() / ".claude" / "session-index",
}

OK, WARN, BAD = "ok", "warn", "FAIL"


def sh(args, **kw):
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=20, **kw)
        return r.returncode, r.stdout.strip(), r.stderr.strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, "", str(e)


def cmd_list():
    for name, rel in TOOLS.items():
        p = REPO / rel
        print(f"{name.ljust(14)}  {rel.ljust(24)}  {'present' if p.exists() else 'MISSING'}")


def cmd_install(bin_dir):
    bin_dir.mkdir(parents=True, exist_ok=True)
    for name, rel in TOOLS.items():
        src = REPO / rel
        if not src.exists():
            print(f"{name}: SKIPPED — {rel} not found in the repo")
            continue
        src.chmod(src.stat().st_mode | 0o111)
        dest = bin_dir / name
        if dest.is_symlink() or dest.exists():
            if dest.is_symlink() and dest.resolve() == src.resolve():
                print(f"{name}: already linked")
                continue
            dest.unlink()
        dest.symlink_to(src)
        print(f"{name}: linked -> {src}")
    if str(bin_dir) not in os.environ.get("PATH", "").split(":"):
        print(f"\nnote: {bin_dir} is not on your PATH — add to ~/.zshrc:\n"
              f'  export PATH="{bin_dir}:$PATH"')


def check_tools(bin_dir):
    rows, bad = [], 0
    for name, rel in TOOLS.items():
        src = REPO / rel
        dest = bin_dir / name
        if not src.exists():
            rows.append((BAD, name, f"{rel} missing from the repo")); bad += 1
            continue
        if not dest.exists() and not dest.is_symlink():
            rows.append((BAD, name, f"not installed in {bin_dir} — run 'toolkit install'")); bad += 1
            continue
        if dest.is_symlink() and not dest.resolve().exists():
            rows.append((BAD, name, f"broken symlink -> {os.readlink(dest)} — run 'toolkit install'")); bad += 1
            continue
        if dest.is_symlink() and dest.resolve() != src.resolve():
            rows.append((WARN, name, f"links elsewhere: {dest.resolve()}"))
            continue
        code, out, err = sh([str(dest), "--version"])
        if code != 0:
            code, out, err = sh([str(dest), "version"])
        ver = (out or err).splitlines()[0] if (out or err) else "?"
        if code != 0:
            rows.append((BAD, name, f"does not run: {ver[:60]}")); bad += 1
        else:
            rows.append((OK, name, ver))
    return rows, bad


def check_agents():
    rows, bad = [], 0
    if not LAUNCH_AGENTS.exists():
        return rows, bad
    for plist in sorted(LAUNCH_AGENTS.glob("*.plist")):
        try:
            text = plist.read_text(errors="ignore")
        except OSError:
            continue
        if str(REPO) not in text:
            continue
        m = re.search(r"<key>Label</key>\s*<string>([^<]+)</string>", text)
        label = m.group(1) if m else plist.stem
        script = re.search(r"<string>([^<]*" + re.escape(str(REPO)) + r"[^<]*)</string>", text)
        if script and not Path(script.group(1)).exists():
            rows.append((BAD, label, f"plist points at a missing script: {script.group(1)}")); bad += 1
            continue
        code, _, _ = sh(["launchctl", "list", label])
        if code == 0:
            rows.append((OK, label, "loaded"))
        else:
            rows.append((WARN, label, f"not loaded — launchctl bootstrap gui/$(id -u) {plist}"))
    return rows, bad


def check_directives(bin_dir):
    exe = bin_dir / "claude-toggle"
    if not exe.exists():
        return [(WARN, "directives", "claude-toggle not installed")], 0
    code, out, _ = sh([str(exe), "directives"])
    if code != 0:
        return [(WARN, "directives", "claude-toggle directives failed")], 0
    rows, bad = [], 0
    for line in out.splitlines():
        name = line.split()[0]
        if "OUTDATED" in line:
            rows.append((WARN, f"directive:{name}", f"text outdated — 'claude-toggle {name} refresh'"))
        elif "disabled" in line:
            rows.append((WARN, f"directive:{name}", "disabled"))
        else:
            rows.append((OK, f"directive:{name}", "enabled, current"))
    return rows, bad


def check_indexes():
    rows = []
    for name, path in INDEXES.items():
        if not path.exists():
            rows.append((WARN, name, "not built yet"))
            continue
        files = list(path.glob("*.json"))
        if not files:
            rows.append((WARN, name, "empty"))
            continue
        newest = max(f.stat().st_mtime for f in files)
        age_d = (time.time() - newest) / 86400
        size_kb = sum(f.stat().st_size for f in files) / 1024
        msg = f"{len(files)} index(es), {size_kb:.0f} KB, newest {age_d:.1f}d old"
        rows.append((WARN if age_d > 30 else OK, name, msg))
    return rows, 0


def check_vault(bin_dir):
    exe = bin_dir / "claude-vault"
    if not exe.exists():
        return [], 0
    code, out, err = sh([str(exe), "doctor"])
    msg = (out or err).splitlines()[0] if (out or err) else "?"
    if code != 0:
        return [(WARN, "vault", msg[:80])], 0
    return [(OK if "agree" in msg else WARN, "vault", msg[:80])], 0


def cmd_doctor(bin_dir):
    total_bad = 0
    sections = [("tools", check_tools(bin_dir)),
                ("launchd agents", check_agents()),
                ("directives", check_directives(bin_dir)),
                ("indexes", check_indexes()),
                ("vault", check_vault(bin_dir))]
    for title, (rows, bad) in sections:
        total_bad += bad
        if not rows:
            continue
        print(f"\n{title}:")
        w = max(len(r[1]) for r in rows)
        for status, name, msg in rows:
            mark = {OK: "  ok  ", WARN: " warn ", BAD: " FAIL "}[status]
            print(f"[{mark}] {name.ljust(w)}  {msg}")
    path_ok = str(bin_dir) in os.environ.get("PATH", "").split(":")
    print(f"\nPATH: {'contains' if path_ok else 'MISSING'} {bin_dir}")
    if not path_ok:
        total_bad += 1
    print(f"repo: {REPO}")
    if total_bad:
        print(f"\n{total_bad} problem(s) — see FAIL rows above.")
        return 1
    print("\nall good.")
    return 0


def main():
    args = sys.argv[1:]
    bin_dir = DEFAULT_BIN
    if "--bin" in args:
        i = args.index("--bin")
        if i + 1 >= len(args):
            sys.exit("--bin needs a directory")
        bin_dir = Path(args[i + 1]).expanduser()
        args = args[:i] + args[i + 2:]
    cmd = args[0] if args else "doctor"
    if cmd in ("-h", "--help", "help"):
        print(Path(__file__).read_text().split("\n\nimport")[0]
              .replace("#!/usr/bin/env python3\n", "").replace("# ", "").replace("#", ""))
    elif cmd in ("-v", "--version", "version"):
        print(f"toolkit {VERSION}")
    elif cmd == "install":
        cmd_install(bin_dir)
    elif cmd == "list":
        cmd_list()
    elif cmd == "doctor":
        return cmd_doctor(bin_dir)
    else:
        sys.exit(f"toolkit: unknown command '{cmd}' — see --help")
    return 0


if __name__ == "__main__":
    sys.exit(main())
