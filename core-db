#!/usr/bin/env bash
# core-db — run queries against a CORE Postgres server using credentials
# stored in claude-vault, so no password ever appears on the command line,
# in shell history, or in the transcript.
#
# Connection config comes from the vault entry `<env>-postgres-db` (JSON with
# host/port/user — no password). The password is a separate password-type
# vault entry, one per team member: `<env>-postgres-db.<dbuser>`, with optional
# role variants `<env>-postgres-db.<dbuser>.ro` / `.rw` (view-only vs update).
# Falls back to the config's own `password` field for legacy entries.
# Default environment is prod.
#
# Usage:
#   core-db [--env prod|stg|test|local] [--user <dbuser>] [--role ro|rw] <cmd>
#     databases                # list databases
#     tables <database>        # list tables
#     <database> "<SQL>"       # run inline SQL
#     <database> -f query.sql  # run SQL from a file (--csv for CSV output)
#
# Examples:
#   core-db databases
#   core-db --env stg iamdb "SELECT id, username FROM users LIMIT 5"
#   core-db --role ro iamdb "SELECT ..."     # use the view-only password
#   core-db ordermanagement -f lookup.sql --csv > out.csv

set -euo pipefail

usage() { sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; }

ENV="prod"
DBUSER=""
ROLE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --env)
      ENV="${2:?--env needs prod|stg|test|local}"
      shift 2
      ;;
    --user)
      DBUSER="${2:?--user needs a database user}"
      shift 2
      ;;
    --role)
      ROLE="${2:?--role needs ro or rw}"
      shift 2
      ;;
    *) break ;;
  esac
done

cmd="${1:-}"
if [ -z "$cmd" ] || [ "$cmd" = "-h" ] || [ "$cmd" = "--help" ] || [ "$cmd" = "help" ]; then
  usage
  exit 0
fi

ENTRY="${ENV}-postgres-db"
vault() { claude-vault get "$@"; }

HOST="$(vault "$ENTRY" --field host)"
PORT="$(vault "$ENTRY" --field port 2>/dev/null || echo 5432)"
USER_="${DBUSER:-$(vault "$ENTRY" --field user 2>/dev/null || echo "$USER")}"

# Password resolution: per-member (+role) entry first, then legacy field.
PASS=""
if [ -n "$ROLE" ]; then
  PASS="$(vault "$ENTRY.$USER_.$ROLE" 2>/dev/null || true)"
  if [ -z "$PASS" ]; then
    echo "core-db: no password entry '$ENTRY.$USER_.$ROLE' in claude-vault" >&2
    echo "         add one with: claude-vault set $ENTRY.$USER_.$ROLE --password" >&2
    exit 1
  fi
else
  PASS="$(vault "$ENTRY.$USER_" 2>/dev/null || true)"
  [ -z "$PASS" ] && PASS="$(vault "$ENTRY" --field password 2>/dev/null || true)"
  if [ -z "$PASS" ]; then
    echo "core-db: no password for user '$USER_' — expected vault entry '$ENTRY.$USER_'" >&2
    echo "         add one with: claude-vault set $ENTRY.$USER_ --password" >&2
    exit 1
  fi
fi

# Fail fast if the server isn't reachable — prod/stg RDS endpoints resolve to
# private IPs, so the usual cause is the VPN being disconnected.
if ! nc -z -G 3 "$HOST" "$PORT" >/dev/null 2>&1; then
  echo "core-db: cannot reach $HOST:$PORT ($ENTRY)" >&2
  echo "         if this is an RDS endpoint (private IP), connect to the VPN and retry" >&2
  exit 1
fi

run() {  # run <database> [extra psql args...]
  local db="$1"; shift
  PGPASSWORD="$PASS" psql -h "$HOST" -p "$PORT" -U "$USER_" -d "$db" \
    -v ON_ERROR_STOP=1 "$@"
}

case "$cmd" in
  databases)
    run postgres -tAc "SELECT datname FROM pg_database WHERE NOT datistemplate ORDER BY 1;"
    ;;
  tables)
    db="${2:?usage: core-db [--env <env>] tables <database>}"
    run "$db" -tAc "SELECT table_schema||'.'||table_name FROM information_schema.tables WHERE table_schema NOT IN ('pg_catalog','information_schema') ORDER BY 1;"
    ;;
  *)
    db="$cmd"; shift
    csv=0; args=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --csv) csv=1; shift ;;
        -f) args+=(-f "$2"); shift 2 ;;
        *) args+=(-c "$1"); shift ;;
      esac
    done
    if [ "$csv" -eq 1 ]; then
      run "$db" --csv "${args[@]}"
    else
      run "$db" "${args[@]}"
    fi
    ;;
esac
