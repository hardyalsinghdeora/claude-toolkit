# .claudeignore — paths the toolkit's index/search tools (cindex) skip, so
# task outputs, usage data, and logs never enter an AI session's context.
# Syntax: one pattern per line; # comments; glob (*) supported; a bare name
# matches any path component; trailing / optional for directories.
#
# Note: Claude Code itself does not enforce this file — it is honored by
# cindex (and future toolkit tools). To hard-block Claude from reading a
# path, add a permission deny rule in .claude/settings.json.

# task-specific work products (reviews, reports, dashboards, SQL dumps)
Output/

# Brain/ is deliberately NOT ignored. It is the AI knowledge base — being
# searchable is its entire purpose, and cindex has no --root flag, so excluding
# it here would make it unreachable. It stays out of git via .gitignore; this
# file only controls what AI search can see.

# personal workflow definitions
skills/

# usage data & logs
logs/
*.log

# secrets & local config
.env
*.env

# build/interpreter artefacts
__pycache__/
*.pyc

# archives & OS noise
*.zip
*.bak
.DS_Store
